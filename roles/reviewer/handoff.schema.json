{
 "REVIEWER": {
  "type": "object",
  "required": [
   "handoff",
   "verdict",
   "summary",
   "risk",
   "docs_impact",
   "findings"
  ],
  "x-verdict-from": "findings",
  "properties": {
   "handoff": {
    "enum": [
     "REVIEWER"
    ]
   },
   "verdict": {
    "enum": [
     "approve",
     "changes"
    ]
   },
   "summary": {
    "type": "string"
   },
   "reviewed_sha": {
    "type": "string"
   },
   "risk": {
    "enum": [
     "low",
     "high"
    ]
   },
   "docs_impact": {
    "enum": [
     "yes",
     "no"
    ]
   },
   "findings": {
    "type": "array",
    "items": {
     "type": "object",
     "required": [
      "id",
      "file",
      "finding",
      "severity"
     ],
     "x-blocking-needs": "case",
     "properties": {
      "id": {
       "type": "string"
      },
      "file": {
       "type": "string"
      },
      "finding": {
       "type": "string"
      },
      "case": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "blocking",
        "minor"
       ]
      }
     }
    }
   }
  }
 }
}
