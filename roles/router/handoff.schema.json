{
 "ROUTER-INTAKE": {
  "type": "object",
  "required": [
   "size_estimate",
   "risk"
  ],
  "properties": {
   "size_estimate": {
    "type": "string"
   },
   "risk": {
    "enum": [
     "low",
     "high"
    ]
   },
   "reason": {
    "type": "string"
   },
   "slices": {
    "type": "array",
    "items": {
     "type": "object",
     "required": [
      "title",
      "body"
     ]
    }
   }
  }
 },
 "ROUTER-SUMMARY": {
  "type": "object",
  "required": [
   "complete",
   "acceptance",
   "comment"
  ],
  "properties": {
   "complete": {
    "enum": [
     "yes",
     "no"
    ]
   },
   "acceptance": {
    "type": "array"
   },
   "comment": {
    "type": "string"
   }
  }
 },
 "ROUTER-DIAGNOSE": {
  "type": "object",
  "required": [
   "step",
   "comment"
  ],
  "properties": {
   "step": {
    "type": "string"
   },
   "comment": {
    "type": "string"
   }
  }
 },
 "ROUTER-RECHECK": {
  "type": "object",
  "required": [
   "actionable",
   "reason"
  ],
  "properties": {
   "actionable": {
    "enum": [
     "yes",
     "no"
    ]
   },
   "reason": {
    "type": "string"
   }
  }
 }
}
