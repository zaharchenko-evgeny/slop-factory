{
 "DEVELOPER": {
  "type": "object",
  "required": [
   "handoff",
   "status",
   "branch",
   "commits",
   "files",
   "checks",
   "acceptance",
   "blocked_reason"
  ],
  "properties": {
   "handoff": {
    "enum": [
     "DEVELOPER"
    ]
   },
   "status": {
    "enum": [
     "done",
     "blocked"
    ]
   },
   "branch": {
    "type": "string"
   },
   "commits": {
    "type": "array"
   },
   "files": {
    "type": [
     "string",
     "array"
    ]
   },
   "checks": {
    "type": "array",
    "items": {
     "type": "object",
     "required": ["text", "result"],
     "properties": {
      "text": { "type": "string" },
      "result": { "enum": ["pass", "fail", "not-run"] },
      "reason": { "type": "string" }
     },
     "if": { "properties": { "result": { "const": "not-run" } } },
     "then": { "required": ["reason"] }
    }
   },
   "acceptance": {
    "type": "array"
   },
   "findings_addressed": {
    "type": "array"
   },
   "blocked_reason": {
    "type": "string"
   }
  }
 }
}
