{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory project descriptor (factory.project.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "tracker", "repositories", "workflow", "states", "commands"],
  "properties": {
    "engine": {"type": ["integer", "string"]},
    "team_repository": {"type": "string"},
    "issues_token_env": {"type": "string", "description": "Deprecated (#1236): the secret for writes to a repository the run does not check out and for links between two repositories; a repository's `token` replaces it."},
    "engine_repository": {"type": "string", "default": "https://github.com/zaharchenko-evgeny/slop-factory.git"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string"}}
    },
    "code_host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {"enum": ["github", "space"]},
        "repository": {"type": "string"},
        "project": {"type": "string"},
        "url": {"type": "string"}
      }
    },
    "vcs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {"enum": ["github", "space"]},
        "repository": {"type": "string"},
        "project": {"type": "string"},
        "url": {"type": "string"}
      }
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "oneOf": [
        {"required": ["repository"]},
        {"required": ["url", "project"]}
      ],
      "properties": {
        "adapter": {"type": "string"},
        "repository": {"type": "string"},
        "repositories": {"type": "array", "items": {"type": "string"}, "description": "Ticket repositories (ADR-0024); the first is the tracker."},
        "url": {"type": "string"},
        "project": {"type": "string"},
        "projects": {"type": "object", "propertyNames": {"minLength": 1},
                     "additionalProperties": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"}},
        "repositories": {"type": "array", "items": {"type": "string", "minLength": 1},
                         "description": "Repositories that hold tickets (ADR-0024): each names a `repositories[]` entry."},
        "token_env": {"type": "string"},
        "label_prefix": {"type": "string", "minLength": 1, "description": "Prefix of a stage label: `<label_prefix><stage>` (default `factory:`)."},
        "done_state": {"type": "string"},
        "map_label": {"type": "string"},
        "review_trigger": {"type": "string"},
        "risk_labels": {"type": "object"},
        "docs_impact_label": {"type": "string"},
        "bot_logins": {"type": "array", "items": {"type": "string"}},
        "hold_label": {"type": "string"},
        "pr_fact_labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "needs_human_label": {"type": "string"},
        "lesson_label": {"type": "string"},
        "comment_label": {"type": "string"}
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "default_branch"],
        "properties": {
          "name": {"type": "string"},
          "url": {"type": "string"},
          "default_branch": {"type": "string"},
          "role": {"enum": ["primary", "project"]},
          "environment": {"type": "string"},
          "domains": {"type": "array", "items": {"type": "string"}},
          "secrets": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repositories": {"type": "array", "items": {"type": "string"}},
          "writable": {"type": "array", "items": {"type": "string"}},
          "tokens": {"type": "object", "additionalProperties": {"type": "string"},
                     "description": "Repository name -> the secret that holds its write token (ADR-0027): the gate's issue, label and comment writes to it."},
          "domains": {"type": "array", "items": {"type": "string"}},
          "secrets": {"type": "array", "items": {"type": "string"}},
          "secret_help": {"type": "object", "additionalProperties": {"type": "string"}},
          "variables": {"type": "object", "additionalProperties": {"type": "string"}},
          "vm": {"type": "string"},
          "startup": {"type": "string"},
          "vcs": {
            "type": ["string", "object"],
            "description": "This environment's own vcs (#1070), a name or a block: it overrides the top-level `vcs` (alias `code_host`); unset keys come from it when the adapters match. A selected plugin must provide it.",
            "additionalProperties": false,
            "properties": {
              "adapter": {"type": "string"},
              "repository": {"type": "string"},
              "project": {"type": "string"},
              "url": {"type": "string"}
            }
          },
          "tracker": {
            "type": "object",
            "description": "This environment's own tracker (#1069): unset keys come from the top-level `tracker` when the adapters match; `scope` names its share of that tracker (`label` on github-issues, `field` and `value` on youtrack).",
            "additionalProperties": false,
            "required": ["adapter"],
            "properties": {
              "adapter": {"type": "string"},
              "repository": {"type": "string"},
              "url": {"type": "string"},
              "project": {"type": "string"},
              "token_env": {"type": "string"},
              "done_state": {"type": "string"},
              "repository_field": {"type": "string"},
              "bot_logins": {"type": "array", "items": {"type": "string"}},
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {"type": "string"},
                  "field": {"type": "string"},
                  "value": {"type": "string"},
                  "type": {"type": "string"}
                }
              }
            }
          }
        }
      }
    },
    "workflow": {"type": "string"},
    "states": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "store"],
        "properties": {
          "kind": {"type": "string", "enum": ["active", "waiting", "final"]},
          "store": {"$ref": "#/$defs/store"},
          "waits_for": {"type": "array", "items": {"type": "string"}},
          "remind_after_hours": {"type": "integer"}
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["store"],
        "properties": {"store": {"$ref": "#/$defs/store"}}
      }
    },
    "branch_pattern": {"type": "string"},
    "commit_prefix": {"type": "string"},
    "owner": {"type": "string"},
    "plugins": {"type": "array", "items": {"enum": ["comments", "notify", "notify_email", "github", "youtrack", "space", "air", "local", "claude", "codex", "junie", "pi"]}, "description": "Engine plugins to turn on (ADR-0026): `comments` reacts to comments (mentions, asks, the comment node); `notify` sends the `notify` effect and adds `factory notify test`; `notify_email` is its email channel (and turns on `notify`). Systems, surfaces and agent runners turn on implicitly."},
    "modules": {"type": "array", "items": {"enum": ["comments", "notify", "notify_email", "github", "youtrack", "space", "air", "local", "claude", "codex", "junie", "pi"]}, "description": "The ADR-0025 name of `plugins`."},
    "surface": {"type": "string", "description": "Where the nodes run (ADR-0026): `air` (Air automations, the default when `targets.air` is set) or `local` (ADR-0017). `factory deploy` with no `--target` deploys to it, and `factory validate` checks every node `output:` against what it supports."},
    "notify": {
      "type": "object",
      "properties": {
        "github_user": {"type": "string"}
      }
    },
    "reviews": {"type": "object"},
    "targets": {
      "type": "object",
      "properties": {
        "air": {
          "type": "object",
          "properties": {"mcp_connectors": {"type": "array", "items": {"type": "string"}}}
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "harness": {"enum": ["claude-code", "codex", "junie", "pi"]},
            "models": {"type": "object", "additionalProperties": {"type": "string"}},
            "poll_seconds": {"type": "integer"},
            "workspace": {"type": "string"}
          }
        }
      }
    },
    "defaults": {"type": "object"},
    "models": {"type": "object", "additionalProperties": {"type": "string"}},
    "roles": {
      "type": ["string", "object"],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "mcp": {"type": "array", "items": {"type": "string"}},
          "modes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {"mcp": {"type": "array", "items": {"type": "string"}}}
            }
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "description": "Named role and model bundles that workflow nodes declare with `agent:` (ADR-0020)",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["persona", "role"],
        "properties": {
          "persona": {"type": "string", "description": "lowercase slug, the handle in @factory:<persona>"},
          "role": {"type": "string"},
          "tier": {"type": "string"},
          "tier_high_risk": {"type": "string"},
          "fallback": {"type": "string"},
          "effort": {"type": "string", "description": "reasoning effort, for targets that take one"},
          "tools": {"type": "string"},
          "modes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {"tier": {"type": "string"}, "fallback": {"type": "string"}}
            }
          }
        }
      }
    },
    "limits": {"type": "object"},
    "gates": {"type": "object"},
    "checks": {"type": "array", "items": {"type": "object"}},
    "knowledge": {"type": "object"},
    "ci": {"type": "object"}
  },
  "$defs": {
    "store": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {"required": ["label"]},
        {"required": ["pr_label"]},
        {"required": ["field"]},
        {"required": ["tag"]},
        {"required": ["pr"]}
      ],
      "properties": {
        "label": {"type": "string"},
        "pr_label": {"type": "string"},
        "field": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value"],
          "properties": {"name": {"type": "string"}, "value": {"type": "string"}}
        },
        "tag": {"type": "string"},
        "pr": {"type": "string", "enum": ["open", "approved", "merged", "ci-green", "ci-red", "conflicting"]}
      }
    }
  }
}