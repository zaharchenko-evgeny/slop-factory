{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory team descriptor (factory.descriptor.yaml)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "engine": {
      "description": "Engine version: a tag such as v0.1.0, or main; a number installs main"
    },
    "team_repository": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "default_branch": {
            "type": "string"
          },
          "role": {
            "enum": ["primary", "project"]
          }
        }
      }
    },
    "branch_pattern": {
      "type": "string"
    },
    "commit_prefix": {
      "type": "string"
    },
    "code_host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        }
      }
    },
    "vcs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        }
      }
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "projects": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"}
        },
        "repositories": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "description": "Repositories that hold tickets (ADR-0024): each names a `repositories[]` entry."
        },
        "token_env": {
          "type": "string"
        },
        "label_prefix": {
          "type": "string",
          "minLength": 1
        },
        "done_state": {
          "type": "string"
        },
        "stages": {
          "type": "object"
        },
        "stage_kinds": {
          "type": "object",
          "additionalProperties": { "enum": ["active", "waiting", "final"] }
        },
        "map_label": {
          "type": "string"
        },
        "review_trigger": {
          "type": "string"
        },
        "risk_labels": {
          "type": "object"
        },
        "docs_impact_label": {
          "type": "string"
        },
        "bot_logins": {
          "type": "array"
        },
        "hold_label": {
          "type": "string"
        }
      }
    },
    "owner": {"type": "string"},
    "comment_tag": {"type": "string", "description": "The tag that starts every comment, review and PR body the factory writes, on its own line (#1366). Unset: `[factory]`. Blank: no tag, the text starts at the first line."},
    "plugins": {"type": "array", "items": {"enum": ["comments", "notify", "notify_email", "github", "youtrack", "space", "air", "local", "claude", "codex", "junie", "pi"]}, "description": "Engine plugins to turn on (ADR-0026): `comments` reacts to comments (mentions, asks, the comment node); `notify` sends the `notify` effect and adds `factory notify test`; `notify_email` is its email channel (and turns on `notify`). Systems, surfaces and agent runners turn on implicitly."},
    "modules": {"type": "array", "items": {"enum": ["comments", "notify", "notify_email", "github", "youtrack", "space", "air", "local", "claude", "codex", "junie", "pi"]}, "description": "The ADR-0025 name of `plugins`."},
    "surface": {"type": "string", "description": "Where the nodes run (ADR-0026): `air` (Air automations, the default when `targets.air` is set) or `local` (ADR-0017). `factory deploy` with no `--target` deploys to it, and `factory validate` checks every node `output:` against what it supports."},
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github_user": { "type": "string" }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "air": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bot_login": {
              "type": "string"
            },
            "project_id": {"type": "string", "description": "The Air project (a UUID) that owns the deployed automations (#1387). Unset: personal automations."},
            "mcp_connectors": { "type": "array", "items": { "type": "string" } },
            "models": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "harness": { "enum": ["claude-code", "codex", "junie", "pi"] },
            "models": { "type": "object", "additionalProperties": { "type": "string" } },
            "poll_seconds": { "type": "integer" },
            "workspace": { "type": "string" }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tier": {
            "type": "string"
          },
          "tier_high_risk": {
            "type": "string"
          },
          "fallback": {
            "type": "string"
          },
          "harness": { "enum": ["claude-code", "codex", "junie", "pi"], "description": "local target only" },
          "mcp": { "type": "array", "items": { "type": "string" }, "description": "Air MCP connectors" },
          "tools": {
            "type": "string"
          },
          "dry_run": {
            "type": "boolean"
          },
          "auto_merge": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "max_risk": {
                "type": "string"
              },
              "require": {}
            }
          },
          "modes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tier": {
                  "type": "string"
                },
                "fallback": {
                  "type": "string"
                },
                "harness": { "enum": ["claude-code", "codex", "junie", "pi"], "description": "local target only" },
                "mcp": { "type": "array", "items": { "type": "string" }, "description": "Air MCP connectors" }
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concurrent_deliveries": {
          "type": "integer"
        },
        "fix_rounds": {
          "type": "integer"
        },
        "agent_runs_per_ticket": {
          "type": "integer"
        },
        "stale_hours": {
          "type": "integer"
        },
        "stale_command_minutes": {
          "type": "integer"
        },
        "run_timeout_minutes": {
          "type": "integer"
        },
        "remind_after_hours": {
          "type": "integer"
        },
        "stuck_minutes": {
          "type": "integer"
        },
        "resume_cap": {
          "type": "integer"
        },
        "runs_per_day": {
          "type": "integer"
        },
        "comment_runs_per_day": {
          "type": "integer"
        },
        "environment_repair_attempts": {
          "type": "integer"
        },
        "generated_paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ticket_approval": {
          "type": "string"
        },
        "auto_merge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_risk": {
              "type": "string"
            }
          }
        },
        "confirm_external_writes": {
          "type": "boolean"
        },
        "confirm_external_writes_scope": {
          "type": "array"
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string"
        },
        "dir": {
          "type": "string"
        },
        "distill_branch": {
          "type": "string"
        },
        "distill_every_days": {
          "type": "integer"
        },
        "agents_md_lines": {
          "type": "integer"
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trusted_bots": {
          "type": "array"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "requires": {
            "type": "string"
          },
          "run": {
            "type": "string"
          }
        }
      }
    }
  }
}
